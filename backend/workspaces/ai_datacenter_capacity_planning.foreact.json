          "rationale": "Variance between forecast versions is meaningful only when both versions refer to the same future period."
        },
        {
          "rule_id": "CR-002",
          "name": "Target coverage",
          "description": "Every field with role=target must produce a VarianceSignal and VolatilitySignal for the selected analysis period.",
          "severity": "error",
          "rationale": "A decision card is not meaningful unless each selected target is connected to interpretable signals."
        },
        {
          "rule_id": "CR-003",
          "name": "Semantic metadata completeness",
          "description": "Decision-relevant fields should have a business name, unit, semantic type, and direction.",
          "severity": "warning",
          "rationale": "The tool should not treat columns as anonymous numbers; modelers must make their semantics explicit."
        },
        {
          "rule_id": "CR-004",
          "name": "Method declaration",
          "description": "Variance and volatility methods must be explicitly selected or defined before analysis.",
          "severity": "error",
          "rationale": "Interpretability requires a named computation procedure, not hidden calculations."
        },
        {
          "rule_id": "CR-005",
          "name": "Transformation traceability",
          "description": "DecisionCards must trace to DatasetVersion, SemanticFieldModel, AnalysisScope, MethodModel, AlignedForecastModel, and SignalModel.",
          "severity": "error",
          "rationale": "The user must be able to inspect why a recommendation was produced and which transformation produced it."
        },
        {
          "rule_id": "CR-006",
          "name": "Metamodel extensibility",
          "description": "User-defined concepts must have a name, kind, description, and declared connection to an existing concept.",
