###############################################################################
# Root-level & OS / Editor noise
###############################################################################

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux / general editor backups
*~
*.swp
*.swo
*.swn
.nfs*

# IDEs & editors
.idea/
.fleet/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.history/              # VSCode extension
*.iml                  # IntelliJ module files

# General caches
.cache/
tmp/
temp/
*.tmp
*.bak

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


###############################################################################
# Environment files (both frontend & backend)
###############################################################################

# Generic env files (keep .env.example in repo)
.env
.env.*.local
.env.local
.envrc
.flaskenv
.flaskenv.local

# Local tooling
.python-version


###############################################################################
# Frontend: React + Vite + TypeScript (in /frontend)
###############################################################################

# Node dependencies & outputs
/frontend/node_modules/
/frontend/dist/
/frontend/build/

# Vite cache
/frontend/.vite/

# Testing & coverage (Vitest/Jest)
/frontend/coverage/
.frontend/.nyc_output/

# Lint & TypeScript build info
/frontend/.eslintcache
/frontend/*.tsbuildinfo

# Local config noise
/frontend/*.local


###############################################################################
# Backend: Python + Flask + Poetry (in /backend)
###############################################################################

# Byte-compiled / optimized / DLL files
/backend/__pycache__/
/backend/**/*.py[cod]
/backend/**/$py.class
*.py[cod]
*$py.class
__pycache__/

# Virtual environments (prefer project-local .venv with Poetry)
.venv/
venv/
ENV/
env/
/backend/.venv/
/backend/venv/

# Poetry & build artifacts (do NOT ignore poetry.lock)
.build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Flask instance folder (runtime config, DBs, uploads)
# If you rely on instance config, keep an example in repo.
backend/instance/
backend/instance/*
!backend/instance/.gitkeep

# Databases & SQLite files
/backend/*.db
/backend/*.sqlite
/backend/*.sqlite3

# Unit test / coverage
/.coverage
/.coverage.*
/coverage.xml
/htmlcov/
/.pytest_cache/
/.tox/
/.nox/
.noseids

# Type checkers / static analysis
/.mypy_cache/
/.pytype/
/.pyre/
/.ruff_cache/

# Jupyter (if any notebooks are used for exploration)
/.ipynb_checkpoints
**/.ipynb_checkpoints


###############################################################################
# Tool-specific or framework caches (safe to ignore across the repo)
###############################################################################

# Babel / TS / ESLint (if present at root or subprojects)
.eslintcache
*.tsbuildinfo

# Storybook (if you add it later)
/storybook-static/

# Cypress / Playwright (if used)
/cypress/videos/
/cypress/screenshots/
/playwright-report/
/test-results/


###############################################################################
# Optional: lockfiles — we intentionally DO NOT ignore these
# (ensure they are committed for reproducible installs)
###############################################################################
# !poetry.lock
# !frontend/package-lock.json
# !frontend/yarn.lock

.databricks
